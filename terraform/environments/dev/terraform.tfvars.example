# Copy to terraform.tfvars (gitignored) and fill in per-client values before `terraform apply`.
project_id    = "my-client-dev"
region        = "us-central1"
bucket_location = "US"
environment   = "dev"
client_label  = "acme-corp"
caller_member = "user:you@example.com"

# Enable after the dev state bucket exists. Apply once with a trusted human identity, then copy
# the two WIF outputs into the protected GitHub `dev` environment.
enable_github_wif      = true
github_repository      = "your-org/tds-dbt-favorita"
terraform_state_bucket = "acme-corp-terraform-state"

# Opt in only after creating notification channels outside this module.
enable_monitoring_alerts          = false
monitoring_notification_channel_ids = []

# Use an immutable digest, not a mutable tag. Enable the runner and alert policies together.
enable_monitoring_runner   = false
monitoring_runner_image    = "us-central1-docker.pkg.dev/my-client-dev/vertex/ml-pipeline@sha256:replace-me"
monitoring_slack_webhook_secret_id = "forecast-slack-webhook"
monitoring_runner_schedule = "15 * * * *"

# The service remains IAM-authenticated; grant only explicit callers.
enable_forecast_api          = false
forecast_api_image           = "us-central1-docker.pkg.dev/my-client-dev/vertex/ml-pipeline@sha256:replace-me"
forecast_api_invoker_members = ["user:analyst@example.com"]
forecast_api_max_instances   = 3
