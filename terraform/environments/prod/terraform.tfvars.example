# Copy to terraform.tfvars (gitignored) and fill in per-client values before `terraform apply`.
project_id    = "my-client-prod"
region        = "us-central1"
bucket_location = "us-central1"
environment   = "prod"
client_label  = "acme-corp"
caller_member = "user:you@example.com"

# Opt in only after creating notification channels outside this module.
enable_monitoring_alerts            = false
monitoring_notification_channel_ids = []

# Use an immutable digest, not a mutable tag. Enable the runner and alert policies together.
enable_monitoring_runner   = false
monitoring_runner_image    = "us-central1-docker.pkg.dev/my-client-prod/vertex/ml-pipeline@sha256:replace-me"
monitoring_slack_webhook_secret_id = "forecast-slack-webhook"
monitoring_runner_schedule = "15 * * * *"

# The service remains IAM-authenticated; grant only explicit callers.
enable_forecast_api           = false
enable_forecast_api_mutations = false
enable_forecast_publication_webhook = false
forecast_publication_webhook_url_secret_id = "forecast-publication-webhook-url"
forecast_publication_webhook_signing_secret_id = "forecast-publication-webhook-signing"
forecast_publication_webhook_name = "planning-system"
forecast_api_image           = "us-central1-docker.pkg.dev/my-client-prod/vertex/ml-pipeline@sha256:replace-me"
forecast_api_invoker_members = ["group:forecast-consumers@example.com"]
enable_forecastlab_iap       = true
forecastlab_iap_access_members = ["group:forecast-consumers@example.com"]
forecastlab_lifecycle_role_members = {}
forecast_api_min_instances   = 0
forecast_api_max_instances   = 10
